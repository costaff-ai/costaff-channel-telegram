{
  "name": "telegram",
  "version": "0.1.0-alpha-2",
  "description": "Telegram 通訊頻道 Bot。",
  "a2a_service": "telegram",
  "port": 8080,
  "public_port": 18090,
  "env_required": [
    "TELEGRAM_BOT_TOKEN",
    "ID_SALT"
  ],
  "env_optional": [
    "ADK_API_BASE_URL",
    "ADK_APP_NAME",
    "ADK_SESSION_SERVICE_URI",
    "COSTAFF_PREFERRED_LANGUAGE"
  ],
  "health_path": "/.well-known/agent-card.json"
}
