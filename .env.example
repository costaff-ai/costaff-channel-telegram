# =============================================================================
# CoStaff — Telegram Channel Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env  →  cp .env.example .env
#   2. Fill in all [REQUIRED] fields
#   3. ID_SALT must match the value in your core CoStaff .env
#
# Quick way to generate a strong random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================


# -----------------------------------------------------------------------------
# TELEGRAM  [REQUIRED]
# -----------------------------------------------------------------------------

# Bot token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=


# -----------------------------------------------------------------------------
# CORE CONNECTION  [REQUIRED — must match core CoStaff .env]
# -----------------------------------------------------------------------------

# Must match ADK_SESSION_SERVICE_URI in core .env. Substitute your own
# database credentials — do NOT ship the placeholder password.
ADK_SESSION_SERVICE_URI=postgresql+asyncpg://<db-user>:<db-password>@postgres:5432/<db-name>

# Must match ID_SALT in core .env — same value for consistent user identity
ID_SALT=REPLACE_WITH_A_RANDOM_STRING


# -----------------------------------------------------------------------------
# GENERAL  [OPTIONAL]
# -----------------------------------------------------------------------------

# Language for agent responses (e.g. "Traditional Chinese (繁體中文)", "English")
COSTAFF_PREFERRED_LANGUAGE=Traditional Chinese (繁體中文)
